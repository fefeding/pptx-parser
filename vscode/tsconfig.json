{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "paths": {
      "@fefeding/ppt-parser": ["../src/index.ts"],
      "@fefeding/ppt-parser/chart-renderer": ["../examples/chart-lib/chart-renderer.js"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../src/css/css.d.ts",
    "./node_modules/@types/vscode/index.d.ts"
  ]
}
