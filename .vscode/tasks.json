{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "path": "vscode",
      "problemMatcher": [],
      "label": "pptx-ext: compile",
      "detail": "在 vscode 子目录用 esbuild 打包 extension.js 与 webview.js"
    },
    {
      "type": "npm",
      "script": "dev",
      "path": "vscode",
      "problemMatcher": {
        "owner": "esbuild-watch",
        "pattern": {
          "regexp": "^\\[watch\\] build finished.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[esbuild\\] watching for changes",
          "endsPattern": "^\\[watch\\] build finished"
        }
      },
      "isBackground": true,
      "label": "pptx-ext: watch",
      "detail": "持续编译 vscode 插件；改动后在扩展开发宿主窗口按 Ctrl/Cmd+R 刷新"
    }
  ]
}
