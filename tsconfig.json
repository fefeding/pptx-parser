{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler", // ✅ 核心修改：改为Bundler，适配Rollup打包，TS官方推荐
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist/types",
    "rootDir": "./src",
    // ✅ 已开启完整严格模式（strictNullChecks / noImplicitThis / strictFunctionTypes 等）
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true, // ✅ 已开启：全部隐式 any 已显式标注（strict 仍待后续收紧）
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "rollup.config.mjs", "examples", "docs"]
}
