{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler", // ✅ 核心修改：改为Bundler，适配Rollup打包，TS官方推荐
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist/types",
    "rootDir": "./src",
    // ⚠️ 迁移期配置：源码已全量转为 TypeScript(.ts)，但类型尚未逐处补全，
    // 暂时放宽严格检查以保证 tsc / 构建 / 测试通过；后续应逐文件收紧至 true。
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "rollup.config.mjs", "examples", "docs"]
}
